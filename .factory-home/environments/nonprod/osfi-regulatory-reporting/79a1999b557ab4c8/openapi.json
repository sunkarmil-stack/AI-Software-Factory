{
  "info": {
    "title": "Regulatory Returns API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "ok"
          }
        },
        "x-require-mfa": false,
        "x-required-scope": "public"
      }
    },
    "/returns": {
      "get": {
        "operationId": "listReturns",
        "responses": {
          "200": {
            "description": "returns"
          },
          "401": {
            "description": "unauthenticated"
          },
          "403": {
            "description": "forbidden"
          }
        },
        "x-require-mfa": false,
        "x-required-scope": "returns:read"
      }
    },
    "/returns/{return_id}": {
      "get": {
        "operationId": "getReturn",
        "responses": {
          "200": {
            "description": "return"
          },
          "401": {
            "description": "unauthenticated"
          },
          "403": {
            "description": "forbidden"
          },
          "404": {
            "description": "not found"
          }
        },
        "x-require-mfa": false,
        "x-required-scope": "returns:read"
      }
    },
    "/returns/{return_id}/receipts": {
      "post": {
        "operationId": "recordFilingReceipt",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "filed_by": {
                    "type": "string"
                  },
                  "idempotency_key": {
                    "type": "string"
                  },
                  "receipt_ref": {
                    "minLength": 8,
                    "type": "string"
                  }
                },
                "required": [
                  "receipt_ref",
                  "filed_by"
                ],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "receipt recorded"
          },
          "400": {
            "description": "invalid"
          },
          "403": {
            "description": "forbidden"
          },
          "404": {
            "description": "not found"
          },
          "409": {
            "description": "not certified"
          }
        },
        "x-require-mfa": true,
        "x-required-scope": "returns:file"
      }
    }
  }
}
